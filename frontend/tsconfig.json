{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"],
  // TODO sicherung 1.0.1: the module's own test (7685875) has parameters it never reads, which this app's strict
  // settings refuse; vitest still runs it. Comes out once the module's copy passes `tsc` (einst-fragen, question 15).
  "exclude": ["src/vendor/nexsicherung/sicherung.test.tsx"]
}
